DISCORD_TOKEN=
TEST_GUILD_ID=
BOT_BLACKLIST_IDS=
ATRI_OWNER_DISCORD_ID=
PUNISHMENT_GUILD_ID=
PUNISHMENT_ANNOUNCE_CHANNEL_ID=
# One-server self-service role panel. ROLE_CLAIM_OPTIONS_JSON is a compact JSON
# list with key, label, role_id, and optional description fields.
ROLE_CLAIM_GUILD_ID=
ROLE_CLAIM_MANAGER_ROLE_ID=
ROLE_CLAIM_OPTIONS_JSON=[]
QQMUSIC_COOKIE=
QQMUSIC_COOKIE_FILE=config/credentials/qqmusic_cookie.txt
QQMUSIC_QUALITY=auto
QQMUSIC_GUID=10000
QQMUSIC_AUTO_REFRESH=true
QQMUSIC_REFRESH_CHECK_SECONDS=3600
QQMUSIC_REFRESH_MAX_AGE_HOURS=24
QQMUSIC_REFRESH_EXPIRE_MARGIN_HOURS=24
QQMUSIC_COOKIE_NOTIFY_DM=true
QQMUSIC_COOKIE_NOTIFY_USER_ID=
QQMUSIC_COOKIE_NOTIFY_EXPIRE_HOURS=72
QQMUSIC_COOKIE_NOTIFY_COOLDOWN_HOURS=12
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TEMPERATURE=0.9
OPENAI_VISION_TEMPERATURE=0.2
OPENAI_TIMEOUT=60
OPENAI_STREAM_INCLUDE_USAGE=true
CHAT_HISTORY_LIMIT=200
# PDF attachments are parsed in memory. Bulk document text is summarized by
# an ephemeral bridge instead of being persisted in normal DSH channel history.
CHAT_PDF_MAX_BYTES=12582912
CHAT_PDF_MAX_PAGES=120
CHAT_PDF_MAX_TEXT_CHARS=80000
CHAT_PDF_RENDERED_PAGES=3
CHAT_PDF_PARSE_TIMEOUT=30
ATRI_SYSTEM_PROMPT=
ATRI_CHAT_BLACKLIST_IDS=
ATRI_CHAT_GUILD_WHITELIST_IDS=
ATRI_TASK_EMOJI_DANGJI=
ATRI_TASK_EMOJI_MIAOMIAO=
ATRI_TASK_EMOJI_DIE=
ATRI_TASK_EMOJI_MAOZHUA=
ATRI_CHAT_LOG_SENSITIVE_CONTENT=false
ATRI_AGENT_V2_ENABLED=false
ATRI_AGENT_V2_OWNER_ONLY=false
# 所有者显式使用 /改进自己 时才开放受限的项目读写工具；不会开放任意 shell
ATRI_AGENT_CODE_ENABLED=false
# 留空会在 %LOCALAPPDATA%/ATRI/agent-session.key 自动生成 32 字节本机密钥
ATRI_AGENT_SESSION_SECRET=
# 默认使用 %LOCALAPPDATA%/ATRI/agent-sessions；只在需要时覆盖
ATRI_AGENT_SESSION_ROOT=
ATRI_DSH_PROVIDER=atri-gateway
ATRI_DSH_NODE=
ATRI_DSH_CONTEXT_WINDOW=140000
# pi-ai 模型能力描述，仅用于识别真正的上游窗口溢出；不要拿它当聊天记忆长度。
ATRI_DSH_PROVIDER_CONTEXT_WINDOW=1048576
# 维护 Agent 可按其模型单独覆盖；留空则继承上面的 provider window。
ATRI_AGENT_CODE_PROVIDER_CONTEXT_WINDOW=
ATRI_DSH_MAX_TOKENS=
ATRI_DSH_REQUEST_TIMEOUT=600
# DSH 使用单行 JSON-RPC；默认允许 8 MiB，防止 asyncio 默认 64 KiB 截断大型事件。
# 可设 262144～33554432；超出范围会自动钳制。
ATRI_DSH_STDIO_LIMIT_BYTES=8388608
# DSH JSONL 为追加日志；超过该大小且已有压缩摘要时，自动换新会话并继承摘要
ATRI_DSH_SESSION_REBUILD_MB=4
# 开发 Agent 单任务可顺序进行多次模型和工具调用，因此使用更长的总超时
ATRI_DSH_CODE_REQUEST_TIMEOUT=600
ATRI_CHAT_TASK_TIMEOUT_SECONDS=900
# 所有频道共用的上游请求起步间隔；防止并发消息瞬间冲击同一个 API
ATRI_AGENT_API_MIN_INTERVAL_SECONDS=1
# 仅在尚未调用工具且流响应中断时，ATRI 唯一一次安全重试前的全局退避
ATRI_AGENT_API_RETRY_DELAY_SECONDS=3
# 上游返回 429 后，所有频道和联网搜索请求共同暂停的秒数
ATRI_AGENT_API_RATE_LIMIT_COOLDOWN_SECONDS=30
# 删除/封禁/清理等操作等待主人点击 atri_maozhua 的时间（15～300 秒）
ATRI_DESTRUCTIVE_CONFIRM_TIMEOUT_SECONDS=60
# 只清理 ATRI 白名单缓存/轮转日志；默认保留 24 小时，每 6 小时扫描一次
ATRI_CLEANUP_RETENTION_HOURS=24
ATRI_CLEANUP_INTERVAL_SECONDS=21600
# 独立维护 Agent API；不会回退到普通聊天 OPENAI_*，防止代码进入聊天供应商上下文
ATRI_AGENT_CODE_BASE_URL=
ATRI_AGENT_CODE_API_KEY=
ATRI_AGENT_CODE_MODEL=
ATRI_AGENT_CODE_MAX_TOKENS=

